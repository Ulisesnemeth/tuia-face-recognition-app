APP_NAME=Facial Recognition TP1
# Modelo de reconocimiento (ArcFace ResNet50, embedding 512) dentro de MODEL_PATH.
MODEL_NAME=w600k_r50.onnx
SIMILARITY_METRIC=cosine
# Umbral PROVISIONAL: se calibra en la Parte 2 sobre validación.
SIMILARITY_THRESHOLD=0.40
EMBEDDINGS_PATH=data/embeddings.json
DATA_PATH=data
OUTPUT_PATH=output
# Orígenes permitidos para CORS (coma). Use * en desarrollo.
CORS_ORIGINS="http://localhost:8080,http://127.0.0.1:8080"
MODEL_PATH=models
# Detector SCRFD (paquete buffalo_l). Se carga con insightface.model_zoo.get_model,
# por eso necesita el .onnx real y no un state_dict.
DETECTOR_MODEL_NAME=det_10g.onnx
# Score mínimo de detección y tamaño de entrada del detector
DET_SCORE_THRESHOLD=0.5
DET_INPUT_SIZE=640
# Lado mínimo (px) de la caja para aceptar un rostro
MIN_FACE_SIZE=20
# Margen relativo alrededor de la caja al recortar para buscar landmarks
ALIGN_MARGIN=0.5
MAX_WORKERS=2
FACE_SIZE=112
# Debe coincidir con el modelo (ArcFace de InsightFace = 512).
EMBEDDING_DIM=512

# PostgreSQL / pgvector
# En local sin Docker no hay Postgres: usar false para persistir en JSON.
USE_PGVECTOR=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=faces
POSTGRES_USER=faces_user
POSTGRES_PASSWORD=faces_pass
